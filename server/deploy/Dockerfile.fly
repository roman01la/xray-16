FROM rust:1.93.1-bookworm AS build
WORKDIR /src
COPY server/Cargo.toml server/Cargo.lock server/build.rs ./server/
COPY server/src ./server/src
COPY src/xrGame/CombatRules.h src/xrGame/ZoneConditionState.h src/xrGame/ZoneConditionProtocol.h src/xrGame/ZoneConditionHit.h src/xrGame/ZoneConditionImport.h ./src/xrGame/
COPY src/Common ./src/Common
COPY src/xrCommon ./src/xrCommon
COPY src/xrCore ./src/xrCore
COPY src/Include/xrAPI ./src/Include/xrAPI
COPY src/utils/xrMiscMath ./src/utils/xrMiscMath
COPY server/config ./server/config
COPY misc/web/multiplayer ./misc/web/multiplayer
RUN cargo build --release --locked --manifest-path server/Cargo.toml --bin zone-server
FROM node:24-bookworm-slim AS node
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates util-linux python3-boto3 libstdc++6 libsdl2-2.0-0 libjpeg8 \
    liblzo2-2 libopenal1 libogg0 libtheora0 libvorbisfile3 libgl1 libgl1-mesa-dri libegl1 libegl-mesa0 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 zone && useradd --uid 10001 --gid zone --no-create-home zone \
    && mkdir /data
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=build /src/server/target/release/zone-server /usr/local/bin/zone-server
COPY --chmod=0755 server/deploy/fly-entrypoint.sh /usr/local/bin/zone-fly-entrypoint
COPY server/web /app/web
COPY server/tools/migrate-cdn.py /app/tools/migrate-cdn.py
EXPOSE 8080/tcp 50000/udp
ENTRYPOINT ["/usr/local/bin/zone-fly-entrypoint"]
