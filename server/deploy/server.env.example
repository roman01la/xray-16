ZONE_HTTP_ADDR=127.0.0.1:8082
ZONE_UDP_ADDR=0.0.0.0:50000
# Set the server's actual advertised address, not 0.0.0.0.
ZONE_PUBLIC_ADDR=203.0.113.10:50000
ZONE_ORIGIN=https://your-game.example
ZONE_DATABASE=/var/lib/zone/zone.sqlite
ZONE_MAX_PLAYERS=200
# Supply privately; never commit a real token.
ZONE_DEV_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_ACCESS_TOKEN
# Owned game files stay outside source/image. Optional for synthetic smoke test:
# ZONE_COLLISION_MANIFEST=/var/lib/zone/collision/zaton.json
RUST_LOG=zone_server=info,str0m=warn
